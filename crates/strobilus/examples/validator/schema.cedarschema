entity User {
    counter: Long,
    nickname?: String,
};

entity AdminUser in [User];

entity File {
    name?: String,
};

entity PrivateFile in [File];

entity Folder;

action read appliesTo {
    principal: [User, AdminUser],
    resource:  [File, PrivateFile, Folder],
};

action write appliesTo {
    principal: [AdminUser],
    resource:  [File, PrivateFile, Folder],
};
